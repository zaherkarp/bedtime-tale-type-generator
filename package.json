{
  "name": "bedtime-tale-type-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "sync:atu": "node --experimental-strip-types scripts/sync-atu-index.ts",
    "sync:atu:check": "node --experimental-strip-types scripts/sync-atu-index.ts --check",
    "build:icons": "node --experimental-strip-types scripts/build-icons.ts",
    "catalogue:propose": "node --experimental-strip-types scripts/propose-catalogue.ts",
    "catalogue:build": "node --experimental-strip-types scripts/build-catalogue.ts",
    "catalogue:check": "node --experimental-strip-types scripts/build-catalogue.ts --check",
    "motifs:build": "node --experimental-strip-types scripts/build-motifs.ts",
    "motifs:check": "node --experimental-strip-types scripts/build-motifs.ts --check",
    "tale-catalogue:build": "node --experimental-strip-types scripts/build-tale-catalogue.ts",
    "tale-catalogue:check": "node --experimental-strip-types scripts/build-tale-catalogue.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
